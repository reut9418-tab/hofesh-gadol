{
  // Cloudflare Worker: מגיש את הממשק + מעביר /api לשרת ה-Node
  "name": "summer-vacation",
  "main": "worker/index.js",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // בלי זה, ניווט מלא (פתיחת המכתב/הייצוא בטאב) ל-/api מקבל את דף ה-SPA
    // במקום להגיע ל-Worker שמפרקסה לשרת
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // כתובת שרת ה-API (ציבורית — לא סוד; הסודות של Supabase נשארים בשרת בלבד)
    "API_ORIGIN": "https://hofesh-gadol.onrender.com"
  },
  // הדומיין summer-vacation.gebmgroup.com מחובר ל-Worker ישירות דרך ה-API
  // (PUT /accounts/{id}/workers/domains) כי לטוקן אין הרשאת Zone→Workers Routes.
  // הוא נשאר מחובר בין פריסות — אין צורך להגדיר כאן routes.
  "workers_dev": true
}
