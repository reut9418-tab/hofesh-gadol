# העתיקי קובץ זה ל-.env ומלאי את הערכים

# חיבור ל-Supabase Postgres (ריק = עבודה מול SQLite מקומי chofesh.db)
# ב-Supabase: Project Settings ← Database ← Connection string ← URI (Session pooler)
# להחליף את [YOUR-PASSWORD] בסיסמת המסד שבחרת ביצירת הפרויקט
DATABASE_URL=

# כתובת הממשק המורשית (CORS). בענן: https://summer-vacation.gebmpro.co.il
CORS_ORIGIN=http://localhost:5273

# פורט השרת
PORT=3101
